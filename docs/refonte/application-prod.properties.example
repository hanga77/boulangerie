# Profil production — ne pas committer de secrets

spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/boulangerie_bd}
spring.datasource.username=${DB_USERNAME}
spring.datasource.password=${DB_PASSWORD}

# Licence — OBLIGATOIRE en prod (openssl rand -hex 32)
app.license.salt=${LICENSE_SALT}

app.upload-dir=${UPLOAD_DIR:/var/gestiboul/uploads}

server.servlet.session.timeout=30m
server.servlet.session.cookie.http-only=true
server.servlet.session.cookie.secure=true
server.servlet.session.cookie.same-site=strict

management.endpoints.web.exposure.include=health,info,metrics
management.endpoint.health.show-details=when_authorized

springdoc.api-docs.enabled=false
springdoc.swagger-ui.enabled=false

logging.level.lab.hang.Gestion.boulangerie=INFO
logging.level.org.springframework.security=WARN
